# Copy to .env and fill in from your Supabase project settings (API section).
#
# The anon key is designed to be public and ships in the client bundle.
# Row-level security is what protects the data, not secrecy of this key.
# The service-role key is NOT here by design: it never reaches the browser,
# and is set as an edge function secret in the Supabase dashboard instead.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
